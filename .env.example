# ============================================================
# 算上一卦 · 本地 AI 中转服务配置
# ============================================================
# 使用方法：
#   1. 把本文件复制一份，改名为 .env（同目录）
#   2. 在下方填入你自己的 API Key
#   3. 双击「启动代理.bat」或运行 node server/proxy.js
#
# ⚠️ 重要：.env 文件已被 .gitignore 忽略，永远不会被提交到 GitHub。
#    你的 Key 只存在于本机这个服务的进程内存里，不会下发给浏览器，
#    也不会出现在网页源码中。即使别人打开你的网页，也拿不到你的 Key。
# ============================================================


# ---- 必填：你的 API Key ----
# 厂商示例（用哪个就填哪个的 key，其余变量也跟着换）：
#   DeepSeek : sk-...          → LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
#   MiniMax  : eyJ...          → LLM_BASE_URL=https://api.minimax.chat/v1/text/chatcompletion_v2
#   通义千问  : sk-...          → LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   豆包/火山 : ...             → LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
#   本地 Ollama: 无需 key       → LLM_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_API_KEY=

# ---- 上游接口地址（OpenAI 兼容格式）----
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions

# ---- 模型名 ----
LLM_MODEL=deepseek-chat

# ---- 本地服务监听设置 ----
# 只监听 127.0.0.1 表示仅本机可访问，最安全。
# 不要改成 0.0.0.0，除非你清楚风险（那会让局域网内其他设备也能调用你的 key）。
HOST=127.0.0.1
PORT=8787

# ---- 上游请求超时（毫秒）----
LLM_TIMEOUT_MS=60000
